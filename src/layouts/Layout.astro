---
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import GoogleTagManager from '~/components/GoogleTagManager.astro';
import InquiryDock from '~/components/InquiryDock.astro';
import { absoluteUrl, site, whatsappHref } from '~/lib/site';
import { LOCALES, localizePath } from '~/i18n/locales';
import { getMessages } from '~/i18n/messages';

interface Props {
  title: string;
  description: string;
  englishPath: string;
  lang?: string;
  image?: string;
  noindex?: boolean;
  schemas?: unknown[];
}

const { title, description, englishPath, lang = 'en', image = '/brand/logo.png', noindex = false, schemas = [] } = Astro.props;
const locale = LOCALES.find((item) => item.code === lang) || LOCALES[0];
const t = getMessages(lang);
// Only the home page has real translations (title, H1 and body). Other /<lang>/
// copies translate the navigation only, so they are not declared as hreflang
// alternates and their canonical is the English page.
const translated = englishPath === '/';
const canonicalPath = translated ? localizePath(englishPath, lang) : englishPath;
const canonical = absoluteUrl(canonicalPath);
const imageUrl = image.startsWith('http') ? image : absoluteUrl(image);
const robots = noindex ? 'noindex,follow' : 'index,follow';
---

<!doctype html>
<html lang={locale.htmlLang} dir={locale.dir}>
  <head>
    <GoogleTagManager location="head" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0f5c3c" />
    <link rel="icon" type="image/png" sizes="32x32" href="/wp-content/uploads/2024/04/cropped-LOGO04-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/wp-content/uploads/2024/04/cropped-LOGO04-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/wp-content/uploads/2024/04/cropped-LOGO04.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sheerherb" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {
      !noindex && translated &&
        LOCALES.map((item) => (
          <link rel="alternate" hreflang={item.htmlLang} href={absoluteUrl(localizePath(englishPath, item.code))} />
        ))
    }
    {
      !noindex && !translated && lang === 'en' && (
        <link rel="alternate" hreflang="en" href={absoluteUrl(englishPath)} />
      )
    }
    {!noindex && (translated || lang === 'en') && <link rel="alternate" hreflang="x-default" href={absoluteUrl(englishPath)} />}
    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />)}
  </head>
  <body class="has-header">
    <GoogleTagManager location="body" />
    <a class="skip" href="#main">{t.skip}</a>
    <Header lang={lang} englishPath={englishPath} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <InquiryDock lang={lang} />
    <div class="mobile-bar">
      <button class="ghost" type="button" data-open-quote>{t.quote}</button>
      <a class="solid" href={localizePath('/get-a-quote/', lang)}>{t.quote}</a>
    </div>
  </body>
</html>
